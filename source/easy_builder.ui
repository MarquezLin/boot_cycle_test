    <width>720</width>
    <height>540</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>補充等待與畫面檢查</string>
  </property>
  <property name="font">
   <font>
    <family>Microsoft JhengHei UI</family>
    <pointsize>10</pointsize>
   </font>
  </property>
  <layout class="QVBoxLayout" name="layout">
   <item>
    <widget class="QLabel" name="intro">
     <property name="text">
      <string>只補充掃描無法直接建立的步驟：等待、框選畫面檢查、OCR 文字比對。加入後不會立即執行。</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="checksGroup">
     <property name="title">
      <string>補充步驟</string>
     </property>
     <layout class="QGridLayout" name="checksLayout">
      <item row="0" column="0" colspan="2">
       <widget class="QCheckBox" name="contentCheck">
        <property name="text">
         <string>框選畫面：檢查有內容</string>
        </property>
       </widget>
      </item>
      <item row="0" column="2" colspan="2">
       <widget class="QCheckBox" name="motionCheck">
        <property name="text">
         <string>框選畫面：檢查有變化</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QCheckBox" name="textCompareCheck">
        <property name="text">
         <string>框選文字（OCR）比對</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1" colspan="3">
       <widget class="QLineEdit" name="expectedTextEdit">
        <property name="maxLength">
         <number>512</number>
        </property>
        <property name="placeholderText">
         <string>預期文字，例如 Running、Stopped、No Signal、執行中</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="textConditionLabel">
        <property name="text">
         <string>比對方式</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1" colspan="3">
       <widget class="QComboBox" name="textConditionCombo" />
      </item>
      <item row="3" column="0">
       <widget class="QCheckBox" name="delayCheck">
        <property name="text">
         <string>等待時間（Delay）</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1" colspan="3">
       <widget class="QDoubleSpinBox" name="delaySpin">
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="minimum">
         <double>0.100000000000000</double>
        </property>
        <property name="maximum">
         <double>600.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.100000000000000</double>
        </property>
        <property name="value">
         <double>1.000000000000000</double>
        </property>
        <property name="suffix">
         <string> 秒</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="statusLabel">
     <property name="text">
      <string>畫面與 OCR 項目加入後，請框選要檢查的區域；等待時間不需指定目標。</string>
