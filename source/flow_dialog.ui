<ui version="4.0">
 <class>FlowDialog</class>
 <widget class="QDialog" name="FlowDialog">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1100</width><height>820</height></rect></property>
  <property name="windowTitle"><string>GVFG 通用測試流程</string></property>
  <property name="font"><font><family>Microsoft JhengHei UI</family><pointsize>10</pointsize></font></property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item><widget class="QLabel" name="introLabel"><property name="text"><string>編輯流程 → 單步試跑 → 執行完整流程。此介面不執行關機或重開機。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><layout class="QHBoxLayout" name="easyLayout">
    <item><widget class="QPushButton" name="easyButton"><property name="text"><string>建立測試項目…</string></property><property name="minimumSize"><size><width>250</width><height>40</height></size></property></widget></item>
    <item><widget class="QCheckBox" name="advancedCheck"><property name="text"><string>顯示進階設定</string></property></widget></item>
   </layout></item>
   <item><widget class="QGroupBox" name="targetGroup"><property name="title"><string>待測 APP 與 OCR</string></property><layout class="QGridLayout" name="targetLayout">
    <item row="0" column="0"><widget class="QLabel" name="exeLabel"><property name="text"><string>待測 EXE</string></property></widget></item>
    <item row="0" column="1"><widget class="QLineEdit" name="exeEdit"/></item>
    <item row="0" column="2"><widget class="QPushButton" name="browseExeButton"><property name="text"><string>瀏覽…</string></property><property name="maximumSize"><size><width>180</width><height>16777215</height></size></property></widget></item>
    <item row="1" column="0"><widget class="QLabel" name="argsLabel"><property name="text"><string>啟動參數</string></property></widget></item>
    <item row="1" column="1"><widget class="QLineEdit" name="argsEdit"><property name="placeholderText"><string>可留空；含空白的參數請加雙引號</string></property></widget></item>
    <item row="1" column="2"><widget class="QLineEdit" name="cwdEdit"><property name="placeholderText"><string>工作目錄：留空使用 EXE 所在資料夾</string></property></widget></item>
    <item row="2" column="0"><widget class="QLabel" name="ocrLabel"><property name="text"><string>Tesseract EXE</string></property></widget></item>
    <item row="2" column="1"><widget class="QLineEdit" name="ocrEdit"><property name="placeholderText"><string>只有 OCR 步驟需要；保留其 DLL 與 tessdata</string></property></widget></item>
    <item row="2" column="2"><widget class="QPushButton" name="browseOcrButton"><property name="text"><string>選擇 OCR 引擎…</string></property><property name="maximumSize"><size><width>180</width><height>16777215</height></size></property></widget></item>
    <item row="3" column="0"><widget class="QLabel" name="languageLabel"><property name="text"><string>OCR 語言</string></property></widget></item>
    <item row="3" column="1"><widget class="QLineEdit" name="languageEdit"><property name="text"><string>eng</string></property><property name="placeholderText"><string>例如 eng 或 eng+chi_tra；需要對應 traineddata</string></property></widget></item>
    <item row="3" column="2"><widget class="QLabel" name="fileLabel"><property name="text"><string>尚未保存流程</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
    <item row="4" column="0" colspan="3"><widget class="QCheckBox" name="reuseExistingCheck"><property name="text"><string>重用已開啟的待測 APP；未開啟時才啟動</string></property><property name="checked"><bool>true</bool></property></widget></item>
   </layout></widget></item>
