    <item><widget class="QComboBox" name="sampleCombo"/></item>
    <item><widget class="QComboBox" name="sampleSourceCombo"><item><property name="text"><string>文字來源：UIA</string></property></item><item><property name="text"><string>文字來源：OCR</string></property></item></widget></item>
    <item><widget class="QComboBox" name="sampleApplyCombo"><item><property name="text"><string>追加檢查步驟</string></property></item><item><property name="text"><string>取代流程（含啟動／等待）</string></property></item></widget></item>
