    <item row="1" column="2"><widget class="QLabel" name="idLabel"><property name="text"><string>AutomationId</string></property></widget></item>
    <item row="1" column="3"><widget class="QLineEdit" name="idEdit"/></item>
    <item row="2" column="0"><widget class="QLabel" name="textLabel"><property name="text"><string>文字／擷取正規式／快捷鍵</string></property></widget></item>
    <item row="2" column="1"><widget class="QLineEdit" name="textEdit"><property name="placeholderText"><string>Enter / Tab / Esc / Ctrl+A / Ctrl+C / Ctrl+V / Alt+F4</string></property></widget></item>
